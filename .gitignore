# Build trees. D11 defines four: debug, asan, tsan, release.
# Kept outside source directories; never committed.
build/
build-*/
cmake-build-*/

# CMake-generated files, in case a tree is ever configured in-source by mistake.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
CMakeUserPresets.json
_deps/

# Compile database: generated, machine-specific, but useful to editors.
compile_commands.json

# Object files, libraries, executables.
*.o
*.a
*.so
*.so.*
*.out

# Precompiled headers and generated dependency files.
*.gch
*.pch
*.d

# Crash and debug artifacts. Expected while testing shutdown paths and UB.
#
# Anchored with a leading slash. An unanchored "core" matches any file OR
# DIRECTORY named core at any depth, which silently excluded src/core/ and
# include/taskengine/core/ from the repository: git add -A skipped them and
# git status still reported a clean tree. Core dumps land in the working
# directory of the crashing process, which is either the repository root or a
# build tree that is already ignored.
/core
/core.[0-9]*
vgcore.*

# Sanitizer, coverage, and profiler output (D11).
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov
perf.data
perf.data.old
callgrind.out.*

# Editor and tooling state.
.vscode/
.idea/
.cache/
.clangd/
*.swp
*~
